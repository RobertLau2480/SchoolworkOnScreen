{
  "name": "schoolwork-on-screen",
  "version": "1.2.2",
  "private": false,
  "description": "屏上作业 - A touch-friendly homework display for Windows",
  "main": "dist-electron/main.js",
  "author": "OctSeventh (RobertLau)",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "package:full": "npm run build && electron-builder --dir",
    "package:windows": "npm run package:full",
    "package:slim": "npm run build && electron-builder --win portable",
    "package:all": "npm run build && electron-builder --dir && electron-builder --win portable",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "html-to-image": "^1.11.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.5",
    "vite": "^4.5.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.schoolworkonscreen.app",
    "productName": "屏上作业",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "renderer/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/LICENSE*",
      "!**/LICENSES*"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "extraFiles": [
      {
        "from": "config.ini",
        "to": "config.ini"
      },
      {
        "from": "content.json",
        "to": "content.json"
      },
      {
        "from": "fonts",
        "to": "fonts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon-256.png",
      "executableName": "SchoolworkOnScreen",
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
